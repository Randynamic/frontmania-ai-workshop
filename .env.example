# The one secret you get on your card. Authenticates the model proxy, trace ingestion and the workshop backend.
PROXY_API_KEY=
# OpenAI-compatible proxy base URL (LiteLLM behind the gateway). Local stack: http://localhost:8080/proxy/v1
PROXY_BASE_URL=https://34-13-188-3.sslip.io/proxy/v1
# Workshop backend (blind pick page, feedback, prompt registry read, trace read). Local: http://localhost:8080
WORKSHOP_BACKEND_URL=https://34-13-188-3.sslip.io
# OTLP trace endpoint through the gateway; the gateway adds the experiment header. Local: http://localhost:8080/otel/v1/traces
MLFLOW_OTLP_ENDPOINT=https://34-13-188-3.sslip.io/otel/v1/traces
# Model aliases as configured on the proxy; do not put real model names here.
TASK_MODEL=talk-picker-task
EMBED_MODEL=talk-picker-embed
# live (default) or mock. mock runs everything offline with canned model answers; CI and check --static use it.
MODEL_MODE=live
# Optional: debug | info | warn | error
LOG_LEVEL=info
# Page variant only (the blind-pick page issued your id): put TALK_PICKER_ID=<id> in a git-ignored .env.local, not here.
