# Server-side variables for docker compose. Copy to infra/.env; never commit infra/.env.
# Which caddy to start: vps (TLS on 80/443) or local (plain http on 8080/8081).
COMPOSE_PROFILES=vps
# Caddy site; mlflow.<PUBLIC_HOST> is the trainer UI host. Both DNS names must point at the VPS.
PUBLIC_HOST=34-13-188-3.sslip.io
# Let's Encrypt contact
ACME_EMAIL=
# Shared by the mlflow and litellm databases (user: workshop)
POSTGRES_PASSWORD=
# Numeric id of experiment frontmania-2026; created by optimize/seed_prompts.py on D-1, then pasted here and `docker compose up -d` again
MLFLOW_EXPERIMENT_ID=
# Caddy basic_auth for mlflow.<PUBLIC_HOST>; hash from: docker run --rm caddy:2.11.4-alpine caddy hash-password --plaintext '<pw>'
MLFLOW_UI_USER=trainer
MLFLOW_UI_PASSWORD_HASH=
# Same password in plain text: only read by infra/scripts/delete-data.ts and optimize/ on the trainer laptop, never by a container
MLFLOW_UI_PASSWORD=
# How a participant gets a pseudonym (repo-plan 4.1): slip = id printed with the key; page = the blind-pick page issues it
RANKER_PROMPT_VERSION=                # reveal fallback: pin GET /api/prompts/ranker to this registered version instead of alias production; empty = alias
ID_VARIANT=slip
# LiteLLM admin key for /key/generate; never handed out. Must start with sk-
LITELLM_MASTER_KEY=sk-
# LiteLLM key encryption salt; random, never rotate after keys exist
LITELLM_SALT_KEY=
# Upstream: Google Vertex AI. Project and region (europe-west4 = Eemshaven, NL; data stays in the EU)
VERTEX_PROJECT=frontmaniaworkshop
VERTEX_LOCATION=europe-west4
# Service-account key for litellm-vertex@<project> (roles/aiplatform.user only) goes in infra/secrets/vertex-sa.json
# (git-ignored, mounted read-only into litellm). Create: gcloud iam service-accounts keys create infra/secrets/vertex-sa.json --iam-account litellm-vertex@frontmaniaworkshop.iam.gserviceaccount.com
# Delete the key after the workshop: gcloud iam service-accounts keys delete <KEY_ID> --iam-account ...
# Upstream models behind the three aliases (checked available in europe-west4 on 6 Oct 2026)
TASK_MODEL_UPSTREAM=vertex_ai/gemini-2.5-flash
EMBED_MODEL_UPSTREAM=vertex_ai/text-embedding-005
REFLECT_MODEL_UPSTREAM=vertex_ai/gemini-2.5-pro
# Bearer for /api/admin/*; used by infra/scripts and optimize/
WORKSHOP_ADMIN_TOKEN=
# Per participant key: budget in USD (LiteLLM counts USD; assumption Q4: about EUR 2) and requests per minute
KEY_BUDGET_USD=2.2
KEY_RPM=30
# Where infra/scripts reach the stack from the trainer laptop: public gateway and the MLflow UI host (basic auth from the two variables above)
WORKSHOP_BACKEND_URL=https://34-13-188-3.sslip.io
MLFLOW_UI_URL=https://mlflow.34-13-188-3.sslip.io
